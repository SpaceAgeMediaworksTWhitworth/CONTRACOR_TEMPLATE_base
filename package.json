		"remove-decap": "node scripts/remove-decap.js",
		"remove-demo": "node scripts/remove-demo.js",
		"create-page": "node scripts/create-page.js",
		"scaffold": "node scripts/scaffold.js",
		"audit:seo": "node scripts/seo-audit.js",
		"contrast": "node scripts/contrast-check.js",
		"audit": "run-s audit:seo contrast",
		"check": "npm run build && npm run audit"
	},
	"repository": {
		"type": "git",
